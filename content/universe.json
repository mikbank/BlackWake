      "templates": {
        "freight.depart": [
          "Bound for {destination} with {cargo}. Keeping the habitats supplied.",
          "Freight outbound: {cargo} for {destination}. Every crate has a job.",
          "Hauling {cargo} to {destination}. Leave us a little turning room."
        ],
        "freight.dock": [
          "At {destination}. Unloading; please keep the cargo path clear.",
          "Alongside {destination}. Cargo coming off. Many hands, careful fingers.",
          "Unloading at {destination}. The freight gets its shore leave."
        ],
        "freight.complete": [
          "Delivery complete. Preparing the return load; an empty trip helps nobody.",
          "Cargo delivered. Next load, same care.",
          "Delivery complete. Back to loading; the habitats keep eating."
        ],
        "navigation.charging": [
          "Jump charging for {destination}. Please secure loose items.",
          "Charging for {destination}; onward to {finalDestination}. One hop at a time.",
          "Next hop: {destination}. Drive charging. Even the mugs need a berth."
        ],
        "navigation.transfer": [
          "In {system}. Continuing to {destination}; keeping the route moving.",
          "{system} entered. Next duty: reach {destination}.",
          "Through to {system}. Still bound for {destination}; no unpacking yet."
        ],
        "navigation.arrival": [
          "In {system}. Approaching {destination}; we'll take our turn.",
          "Inbound for {destination} in {system}. Leaving room for our neighbours.",
          "{system} reached. On to {destination}; the last leg still counts."
        ],
        "passenger.board": [
          "Boarding for {destination}. Take your time; keep the aisle clear.",
          "Service to {destination} boarding. Lend a hand if your neighbour needs one.",
          "For {destination}, please board. Bags on racks; people get the seats."
        ],
        "passenger.depart": [
          "{passengers} passengers aboard for {destination}. A seat and a safe trip for everyone.",
          "Departing for {destination} with {passengers} aboard. Please keep the aisles clear.",
          "{passengers} aboard. Service to {destination} departing; mind your neighbour's tea."
        ],
        "passenger.dock": [
          "At {destination}. Please let those who need more room leave first.",
          "Welcome to {destination}. Take your bags, and take your time.",
          "{destination} reached. Check your seat for belongings; the next rider has their own."
        ],
        "liner.depart": [
          "{passengers} guests bound for {destination}. Please share the window space.",
          "On to {destination} with {passengers} guests. The view belongs to everyone.",
          "{passengers} guests aboard for {destination}. A little time to look beyond the work."
        ],
        "liner.view": [
          "Now viewing {destination}. Leave a little window for the shorter guests.",
          "At {destination}. Take a look; the maintenance list can wait a moment.",
          "Viewing {destination}. Please share the view, and mind your neighbour's elbow."
        ],
        "patrol.clear": [
          "{sector} checked. Continuing patrol; keeping the shared lanes usable.",
          "Survey of {sector} complete. Looking after the next stretch.",
          "{sector} checked. Back to patrol; quiet is useful work."
        ],
        "patrol.respond": [
          "{target}, cease fire. Patrol responding. Give everyone room to stand down.",
          "{target}, stop firing. These lanes are shared; patrol is responding.",
          "{target}, cease fire. Patrol responding; let the other crews get home."
        ],
        "ship.attacked": [
          "Hostile contact. Route interrupted; nearby crews, keep clear.",
          "Hostile ship nearby. Route on hold; assistance requested.",
          "Route interrupted by hostile contact. Give the other traffic room."
        ],
        "ship.disabled": [
          "Engines disabled. Assistance requested; please leave us room.",
          "Unable to manoeuvre. Engines down; nearby crews, keep clear.",
          "Engines down. We need a hand; please keep the approach clear."
